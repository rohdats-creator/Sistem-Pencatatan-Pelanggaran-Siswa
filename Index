function importViolationsFile(input){
  const file=input.files?.[0];
  if(!file)return;
  loadXLSX(()=>{
    const reader=new FileReader();
    reader.onload=e=>{
      try{
        const wb=XLSX.read(e.target.result,{type:'array'});
        const ws=wb.Sheets[wb.SheetNames[0]];
        const raw=XLSX.utils.sheet_to_json(ws,{defval:''});
        if(!raw.length){alert('File Excel tidak berisi data.');return}
        let added=0,updated=0,skipped=0;
        raw.forEach(row=>{
          const mapped={};
          Object.keys(row).forEach(k=>mapped[normalizeHeader(k)]=String(row[k]??'').trim());
          const code=mapped.kode||mapped.kod_pelanggaran||'';
          const name=mapped.pelanggaran||mapped.namapelanggaran||mapped.nama||'';
          const category=mapped.kategori||'Ringan';
          const points=Number(mapped.poin||mapped.points||0);
          const sanction=mapped.sanksi||mapped.tindakan||'';
          if(!code||!name||!points||!['Ringan','Sedang','Berat'].includes(category)){skipped++;return}
          const existing=data.violations.find(v=>String(v.code).toLowerCase()===code.toLowerCase());
          if(existing){
            existing.name=name;
            existing.category=category;
            existing.points=points;
            existing.sanction=sanction;
            updated++;
          }else{
            data.violations.push({id:Date.now()+Math.floor(Math.random()*100000),code,name,category,points,sanction});
            added++;
          }
        });
        save();refresh();
        document.getElementById('violationImportResult').innerHTML=
          `<b>Import selesai.</b> Ditambahkan: <b>${added}</b>, diperbarui: <b>${updated}</b>, dilewati: <b>${skipped}</b>.`;
        input.value='';
      }catch(err){
        console.error(err);
        alert('File tidak dapat dibaca. Gunakan template Excel SIPES.');
      }
    };
    reader.readAsArrayBuffer(file);
  });
}
