        let added=0,updated=0,skipped=0;
        raw.forEach(row=>{
          const mapped={};
          Object.keys(row).forEach(k=>mapped[normalizeHeader(k)]=String(row[k]??'').trim());
          const nis=mapped.nis||mapped.nisn||'';
          const name=mapped.nama||mapped.namasiswa||'';
          const cls=mapped.kelas||'';
          const major=mapped.jurusan||mapped.programkeahlian||'';
          if(!nis||!name||!cls){skipped++;return}
          const existing=data.students.find(s=>String(s.nis).toLowerCase()===nis.toLowerCase());
          if(existing){
            existing.name=name;
            existing.class=cls;
            existing.major=major;
            updated++;
          }else{
            data.students.push({id:Date.now()+Math.floor(Math.random()*100000),nis,name,class:cls,major});
            added++;
          }
        });
        save();refresh();
        document.getElementById('studentImportResult').innerHTML=
          `<b>Import selesai.</b> Ditambahkan: <b>${added}</b> siswa, diperbarui: <b>${updated}</b>, dilewati: <b>${skipped}</b>.`;
        input.value='';
      }catch(err){
        console.error(err);
        alert('File tidak dapat dibaca. Gunakan template Excel SIPES.');
      }
    };
    reader.readAsArrayBuffer(file);
  });
}
function renderImportPreview(){
  const q=(document.getElementById('importSearch')?.value||'').toLowerCase();
  const rows=data.students.filter(s=>(s.nis+' '+s.name+' '+s.class+' '+s.major).toLowerCase().includes(q));
  document.getElementById('importPreview').innerHTML=rows.map(s=>`
    <tr><td>${esc(s.nis)}</td><td>${esc(s.name)}</td><td>${esc(s.class)}</td><td>${esc(s.major)}</td><td><b>${pointsOf(s.id)}</b></td></tr>
  `).join('')||'<tr><td colspan="5" class="empty">Tidak ada data.</td></tr>';
}

</script>
