<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SIPES - SMK Negeri 1 Gabuswetan</title>
<style>
:root{--primary:#0b5ed7;--primary2:#1d4ed8;--dark:#07182f;--bg:#eef3f8;--card:#fff;--muted:#64748b;--danger:#dc2626;--warning:#d97706;--success:#16a34a;--gold:#f5c451}
*{box-sizing:border-box}body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:var(--bg);color:#172033}
button,input,select,textarea{font:inherit}button{cursor:pointer}
.login{min-height:100vh;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;padding:24px;background:radial-gradient(circle at 20% 20%,#2b6fdc 0,#15376e 36%,#07182f 78%)}
.login:before,.login:after{content:"";position:absolute;border-radius:50%;filter:blur(2px);opacity:.18;pointer-events:none}.login:before{width:520px;height:520px;background:#69a8ff;top:-240px;left:-180px}.login:after{width:420px;height:420px;background:#f5c451;bottom:-220px;right:-160px}
.login-shell{width:min(1040px,96vw);display:grid;grid-template-columns:1.1fr .9fr;background:#ffffff12;border:1px solid #ffffff2c;border-radius:28px;box-shadow:0 30px 80px #0007;backdrop-filter:blur(12px);overflow:hidden;position:relative;z-index:1}
.login-brand{padding:46px 44px;min-height:620px;display:flex;flex-direction:column;justify-content:center;color:#fff;background:linear-gradient(150deg,#0a2348cc,#0c4aa6b8)}
.login-brand .brand-line{width:82px;height:4px;background:var(--gold);border-radius:99px;margin:0 0 22px}.login-brand h1{font-size:34px;line-height:1.15;margin:0 0 12px;letter-spacing:.2px}.login-brand h2{font-size:18px;margin:0 0 10px;font-weight:700;color:#dbeafe}.login-brand p{max-width:500px;color:#dbe7f7;line-height:1.7;margin:0 0 22px}.school-chip{display:inline-flex;align-items:center;gap:10px;width:max-content;padding:9px 13px;border-radius:999px;background:#ffffff14;border:1px solid #ffffff24;font-size:12px;color:#e8f0ff}.login-box{width:100%;background:white;border-radius:0;padding:42px 40px;box-shadow:none;display:flex;flex-direction:column;justify-content:center}.login-box .logo{width:82px;height:82px;border-radius:22px;background:linear-gradient(135deg,#dbeafe,#eff6ff);color:#0b5ed7;display:grid;place-items:center;font-weight:900;font-size:25px;margin-bottom:18px;border:1px solid #bfdbfe;box-shadow:0 10px 25px #0b5ed71a}.login-box h1{margin-bottom:4px;font-size:28px;color:#0f172a}.login-box .muted{margin-bottom:16px}.login-box .field{margin:14px 0}.login-box .btn{padding:12px 15px}.login-box .footer-note{margin-top:12px}.login-caption{font-size:12px;color:#94a3b8;margin-top:20px;text-align:center}
h1,h2,h3{margin-top:0}.muted{color:var(--muted);font-size:14px}
.field{margin:13px 0}.field label{display:block;font-size:13px;font-weight:700;margin-bottom:6px}
input,select,textarea{width:100%;padding:11px 12px;border:1px solid #cbd5e1;border-radius:9px;background:white;outline:none}
input:focus,select:focus,textarea:focus{border-color:#2563eb;box-shadow:0 0 0 3px #2563eb18}
.btn{border:0;border-radius:9px;padding:10px 14px;font-weight:700}.primary{background:var(--primary);color:white}.secondary{background:#e2e8f0;color:#172033}.danger{background:#fee2e2;color:#b91c1c}.success{background:#dcfce7;color:#166534}
.full{width:100%}.error{color:#b91c1c;background:#fee2e2;padding:10px;border-radius:8px;margin:10px 0;display:none}
.app{display:none}.sidebar{position:fixed;left:0;top:0;bottom:0;width:240px;background:#0f172a;color:#cbd5e1;padding:20px 14px;z-index:5}.brand{font-size:20px;font-weight:800;color:white;padding:10px 12px 24px}.brand small{display:block;color:#94a3b8;font-size:11px;margin-top:4px}
.nav button{display:block;width:100%;text-align:left;background:none;border:0;color:#cbd5e1;padding:12px;border-radius:8px;margin:3px 0}.nav button.active,.nav button:hover{background:#1e40af;color:white}
.main{margin-left:240px;min-height:100vh}.topbar{height:68px;background:white;border-bottom:1px solid #e2e8f0;display:flex;align-items:center;justify-content:space-between;padding:0 24px;position:sticky;top:0;z-index:4}.content{padding:24px}.page{display:none}.page.active{display:block}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:22px}.card{background:var(--card);border-radius:14px;padding:18px;box-shadow:0 3px 15px #0f172a0a;border:1px solid #e2e8f0}.stat{font-size:30px;font-weight:800;margin:7px 0}.stat-label{color:var(--muted);font-size:13px}
.toolbar{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin-bottom:15px}.toolbar input{max-width:280px}.table-wrap{overflow:auto;background:white;border-radius:14px;border:1px solid #e2e8f0}.table{width:100%;border-collapse:collapse;min-width:720px}.table th,.table td{padding:11px 13px;border-bottom:1px solid #e2e8f0;text-align:left;font-size:13px}.table th{background:#f8fafc;color:#475569}.badge{display:inline-block;padding:4px 8px;border-radius:99px;font-size:11px;font-weight:700}.b-low{background:#dcfce7;color:#166534}.b-mid{background:#fef3c7;color:#92400e}.b-high{background:#fee2e2;color:#991b1b}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:18px}.actions{display:flex;gap:6px}.empty{text-align:center;padding:35px;color:#94a3b8}
.modal{position:fixed;inset:0;background:#0008;display:none;place-items:center;z-index:20;padding:15px}.modal.show{display:grid}.modal-box{background:white;width:min(650px,100%);max-height:90vh;overflow:auto;border-radius:16px;padding:22px}
.modal-head{display:flex;justify-content:space-between;align-items:center}.close{border:0;background:#f1f5f9;border-radius:8px;padding:6px 10px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.form-grid .fullcol{grid-column:1/-1}
.notice{padding:12px;border-radius:10px;background:#eff6ff;color:#1e40af;margin-bottom:14px;font-size:13px}
.footer-note{font-size:12px;color:#94a3b8;margin-top:15px}
@media(max-width:900px){.login-shell{grid-template-columns:1fr}.login-brand{min-height:auto;padding:30px}.login-brand h1{font-size:28px}.login-box{padding:34px 30px}.sidebar{width:70px}.brand{font-size:0}.brand:after{content:"SP";font-size:20px}.nav button{font-size:0;text-align:center}.nav button:before{font-size:20px}.main{margin-left:70px}.cards{grid-template-columns:1fr 1fr}.grid2{grid-template-columns:1fr}}
@media(max-width:560px){.login{padding:12px}.login-shell{border-radius:20px}.login-brand{display:none}.login-box{padding:28px 22px}.cards{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.content{padding:14px}.topbar{padding:0 14px}}
@media print{.sidebar,.topbar,.toolbar,.no-print{display:none!important}.main{margin:0}.content{padding:0}.page{display:none!important}.page.printable{display:block!important}.table-wrap{border:0}.card{box-shadow:none}}

.role-notice{background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;padding:14px;border-radius:10px;margin-bottom:18px}
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<style>
@media print{
  body *{visibility:hidden!important}
  #reportArea,#reportArea *{visibility:visible!important}
  #reportArea{position:absolute!important;left:0!important;top:0!important;width:100%!important;margin:0!important;padding:20px!important;display:block!important}
  .no-print{display:none!important}
}
</style></head>
<body>

<div id="login" class="login">
  <div class="login-shell">
    <div class="login-brand">
      <div class="school-chip">SMK NEGERI 1 GABUSWETAN • INDRAMAYU</div>
      <div style="height:18px"></div>
      <div class="brand-line"></div>
      <h1>Sistem Informasi Pencatatan Pelanggaran Siswa</h1>
      <h2>SMK NEGERI 1 GABUSWETAN</h2>
      <p>Platform digital untuk membantu sekolah mencatat, memantau, dan merekap data kedisiplinan siswa secara terstruktur.</p>
      <div class="school-chip">Program Keahlian Teknik Kendaraan Ringan</div>
    </div>
    <div class="login-box">
      <div class="logo">SP</div>
      <h1>Selamat Datang</h1>
      <div class="muted">Silakan masuk untuk mengelola data kedisiplinan siswa.</div>
      <div class="field"><label>Username</label><input id="loginUser" value="" autocomplete="username" placeholder="Masukkan username"></div>
      <div class="field"><label>Password</label><input id="loginPass" type="password" value="" autocomplete="current-password" placeholder="Masukkan password"></div>
      <div id="loginError" class="error">Username atau password salah.</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
        <button class="btn primary" onclick="login()">🔐 Masuk</button>
        <button class="btn secondary" onclick="openRegister()">👤 Daftar</button>
      </div>
      <div class="footer-note">Akun awal: <b></b></b></div>
      <div class="login-caption">SMK Negeri 1 Gabuswetan • Sistem Kedisiplinan Siswa</div>
    </div>
  </div>
</div>

<div id="app" class="app">
<aside class="sidebar">
  <div class="brand">SIPES <small>Manajemen Kedisiplinan Siswa</small></div>
  <div class="nav">
    <button class="active" onclick="showPage('dashboard',this)">📊 &nbsp; Dashboard</button>
    <button onclick="showPage('students',this)">👨‍🎓 &nbsp; Data Siswa</button>
    <button onclick="showPage('violations',this)">⚠️ &nbsp; Master Pelanggaran</button>
    <button onclick="showPage('records',this)">📝 &nbsp; Pencatatan</button>
    <button onclick="showPage('reports',this)">📑 &nbsp; Laporan</button>
    <button onclick="showPage('settings',this)">⚙️ &nbsp; Pengaturan</button>
    <button onclick="showPage('accounts',this)">👤 &nbsp; Akun Admin</button>
  </div>
</aside>

<main class="main">
<header class="topbar"><div><b id="pageTitle">Dashboard</b></div><div><span id="currentUserLabel">Admin</span> &nbsp; <button class="btn secondary" onclick="logout()">Keluar</button></div></header>
<div class="content">

<section id="dashboard" class="page active">
  <div id="studentOnlyNotice" class="role-notice" style="display:none">
    <b>Mode Siswa:</b> Anda hanya dapat melihat Dashboard dan informasi ringkas kedisiplinan.
  </div>
  <div class="cards">
    <div class="card"><div class="stat-label">Total Siswa</div><div id="statStudents" class="stat">0</div></div>
    <div class="card"><div class="stat-label">Total Pelanggaran</div><div id="statRecords" class="stat">0</div></div>
    <div class="card"><div class="stat-label">Total Poin</div><div id="statPoints" class="stat">0</div></div>
    <div class="card"><div class="stat-label">Perlu Pembinaan</div><div id="statNeed" class="stat">0</div></div>
  </div>
  <div class="grid2">
    <div class="card"><h3>5 Siswa dengan Poin Tertinggi</h3><div id="topStudents"></div></div>
    <div class="card"><h3>Pelanggaran Terbaru</h3><div id="latestRecords"></div></div>

  </div>
  <div class="grid2" style="margin-top:18px">
    <div class="card">
      <h3>Grafik Indikator Kedisiplinan</h3>
      <canvas id="dashboardBarChart" height="150"></canvas>
    </div>
    <div class="card">
      <h3>Diagram Status Pembinaan</h3>
      <canvas id="dashboardPieChart" height="150"></canvas>
    </div>
  </div>
</section>

<section id="students" class="page">
  <div class="toolbar">
    <button class="btn primary" onclick="openStudent()">+ Tambah Siswa</button>
    <button class="btn secondary" onclick="downloadStudentTemplate()">📄 Template Excel</button>
    <label class="btn success" for="studentExcelFile">📥 Import Excel</label>
    <input id="studentExcelFile" type="file" accept=".xlsx,.xls,.csv" style="display:none" onchange="importStudentsFile(this)">
    <input id="studentSearch" placeholder="Cari nama/NIS/kelas..." oninput="renderStudents()">
  </div>
  <div id="studentImportResult" class="muted" style="margin:-5px 0 12px 2px"></div>
  <div class="table-wrap"><table class="table"><thead><tr><th>NIS</th><th>Nama</th><th>Kelas</th><th>Jurusan</th><th>Total Poin</th><th>Aksi</th></tr></thead><tbody id="studentTable"></tbody></table></div>
</section>

<section id="violations" class="page">
  <div class="toolbar">
    <button class="btn primary" onclick="openViolation()">+ Tambah Pelanggaran</button>
    <button class="btn secondary" onclick="downloadViolationTemplate()">📄 Template Excel</button>
    <label class="btn success" for="violationExcelFile">📥 Import Excel</label>
    <input id="violationExcelFile" type="file" accept=".xlsx,.xls,.csv" style="display:none" onchange="importViolationsFile(this)">
    <input id="violationSearch" placeholder="Cari pelanggaran..." oninput="renderViolations()">
  </div>
  <div id="violationImportResult" class="muted" style="margin:-5px 0 12px 2px"></div>
  <div class="table-wrap"><table class="table"><thead><tr><th>Kode</th><th>Pelanggaran</th><th>Kategori</th><th>Poin</th><th>Sanksi</th><th>Aksi</th></tr></thead><tbody id="violationTable"></tbody></table></div>
</section>

<section id="records" class="page">
  <div class="toolbar"><button class="btn primary" onclick="openRecord()">+ Catat Pelanggaran</button><input id="recordSearch" placeholder="Cari siswa/pelanggaran..." oninput="renderRecords()"></div>
  <div class="table-wrap"><table class="table"><thead><tr><th>Tanggal</th><th>Siswa</th><th>Kelas</th><th>Pelanggaran</th><th>Poin</th><th>Tindakan</th><th>Aksi</th></tr></thead><tbody id="recordTable"></tbody></table></div>
</section>

<section id="reports" class="page">
  <div class="toolbar no-print"><select id="reportStudent" onchange="renderReport()"><option value="">-- Semua Siswa --</option></select><button class="btn primary" onclick="printReport()">🖨 Cetak Rekapitulasi</button></div>
  <div id="reportArea" class="card printable"></div>
</section>


<section id="accounts" class="page">
  <div class="toolbar">
    <button class="btn primary" onclick="openAccount()">+ Tambah Akun</button>
    <input id="accountSearch" placeholder="Cari username/nama..." oninput="renderAccounts()">
  </div>
  <div class="notice">
    Kelola akun pengguna aplikasi. Tersedia peran <b>Super Admin, Admin, Guru, Siswa, Wali Kelas, dan Ketua Jurusan</b>. Password disimpan secara lokal pada browser untuk versi HTML ini.
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Username</th><th>Nama</th><th>Level</th><th>Status</th><th>Aksi</th></tr></thead>
      <tbody id="accountTable"></tbody>
    </table>
  </div>
</section>



<section id="settings" class="page">
  <div class="card">
    <h3>Pengaturan Sistem Poin</h3>
    <div class="notice">Atur batas poin pembinaan sesuai kebijakan sekolah. Nilai ini disimpan di browser.</div>
    <div class="form-grid">
      <div class="field"><label>Batas Teguran</label><input id="setWarn" type="number"></div>
      <div class="field"><label>Batas Panggilan Orang Tua</label><input id="setParent" type="number"></div>
      <div class="field"><label>Batas Pembinaan Khusus</label><input id="setSpecial" type="number"></div>
      <div class="field"><label>Nama Sekolah</label><input id="setSchool"></div>
    </div>
    <button class="btn primary" onclick="saveSettings()">Simpan Pengaturan</button>
  </div>
</section>

</div></main></div>

<div id="modal" class="modal"><div class="modal-box">
  <div class="modal-head"><h2 id="modalTitle">Form</h2><button class="close" onclick="closeModal()">✕</button></div>
  <div id="modalBody"></div>
</div></div>

<script>
const KEY='sipes_data_v1';
let data = JSON.parse(localStorage.getItem(KEY) || 'null') || {
  students:[
    {id:1,nis:'1001',name:'Budi Santoso',class:'XI TKR 1',major:'Teknik Kendaraan Ringan'},
    {id:2,nis:'1002',name:'Andi Setiawan',class:'X TSM 1',major:'Teknik Sepeda Motor'},
    {id:3,nis:'1003',name:'Siti Rahma',class:'XII AKL 1',major:'Akuntansi dan Keuangan Lembaga'}
  ],
  violations:[
    {id:1,code:'P01',name:'Terlambat masuk sekolah',category:'Ringan',points:5,sanction:'Teguran'},
    {id:2,code:'P02',name:'Tidak memakai atribut lengkap',category:'Ringan',points:5,sanction:'Teguran'},
    {id:3,code:'P03',name:'Membolos',category:'Sedang',points:15,sanction:'Pembinaan wali kelas'},
    {id:4,code:'P04',name:'Merokok di lingkungan sekolah',category:'Berat',points:25,sanction:'Panggilan orang tua'},
    {id:5,code:'P05',name:'Perkelahian',category:'Berat',points:30,sanction:'Pembinaan khusus'}
  ],
  records:[
    {id:1,studentId:1,violationId:1,date:'2026-08-05',note:'Terlambat 15 menit',action:'Teguran'},
    {id:2,studentId:1,violationId:3,date:'2026-08-07',note:'Tidak mengikuti pembelajaran',action:'Pembinaan wali kelas'},
    {id:3,studentId:2,violationId:2,date:'2026-08-08',note:'Atribut tidak lengkap',action:'Teguran'}
  ],
  settings:{warn:5,parent:20,special:30,school:'SMK NEGERI'},
  accounts:[{id:1,username:'admin',password:'admin123',name:'Administrator',level:'Super Admin',active:true}]
};
function save(){localStorage.setItem(KEY,JSON.stringify(data))}
if(!data.accounts){data.accounts=[{id:1,username:'admin',password:'admin123',name:'Administrator',level:'Super Admin',active:true}];save()}
let currentAccount=null;

function openRegister(){
  openModal('Daftar Akun',`
    <div class="notice">Buat akun baru untuk masuk ke SIPES. Akun yang dibuat melalui halaman ini akan berstatus menunggu persetujuan Admin.</div>
    <div class="form-grid">
      <div class="field"><label>Nama</label><input id="regName" placeholder="Nama lengkap"></div>
      <div class="field"><label>Username</label><input id="regUser" placeholder="Username"></div>
      <div class="field"><label>Password</label><input id="regPass" type="password" placeholder="Password"></div>
      <div class="field"><label>Peran</label><select id="regLevel">
        <option>Guru</option>
        <option>Siswa</option>
        <option>Wali Kelas</option>
        <option>Ketua Jurusan</option>
      </select></div>
    </div>
    <button class="btn primary full" onclick="registerAccount()">Daftar</button>
  `);
}
function registerAccount(){
  const name=regName.value.trim(), username=regUser.value.trim(), password=regPass.value, level=regLevel.value;
  if(!name||!username||!password){alert('Nama, username, dan password wajib diisi.');return}
  if(!/^[a-zA-Z0-9._-]+$/.test(username)){alert('Username hanya boleh menggunakan huruf, angka, titik, garis bawah, atau tanda hubung.');return}
  if((data.accounts||[]).some(a=>a.username.toLowerCase()===username.toLowerCase())){
    alert('Username sudah digunakan.');return;
  }
  data.accounts.push({id:Date.now(),username,password,name,level,active:false});
  save();closeModal();
  alert('Pendaftaran berhasil. Akun menunggu diaktifkan oleh Admin melalui menu Akun Admin.');
}
function login(){
 let u=document.getElementById('loginUser').value.trim(),p=document.getElementById('loginPass').value;
 let acc=(data.accounts||[]).find(a=>a.username===u&&a.password===p&&a.active);
 if(acc){
   currentAccount=acc;
   document.getElementById('currentUserLabel').textContent=acc.name+' ('+acc.level+')';
   applyRoleAccess();
   document.getElementById('loginError').style.display='none';
   document.getElementById('login').style.display='none';
   document.getElementById('app').style.display='block';
   refresh();
 }else document.getElementById('loginError').style.display='block'
}
function logout(){
 currentAccount=null;
 document.querySelectorAll('.nav button').forEach(btn=>btn.style.display='block');
 const notice=document.getElementById('studentOnlyNotice');
 if(notice)notice.style.display='none';
 document.getElementById('app').style.display='none';
 document.getElementById('login').style.display='grid'
}

function applyRoleAccess(){
  const role=currentAccount?.level||'';
  const permissions={
    'Siswa':['dashboard'],
    'Wali Kelas':['dashboard','records','reports']
  };
  const allowed=permissions[role];
  const navButtons=document.querySelectorAll('.nav button');
  navButtons.forEach(btn=>{
    const target=(btn.getAttribute('onclick')||'').match(/showPage\('([^']+)'/);
    if(!target)return;
    const page=target[1];
    btn.style.display=allowed ? (allowed.includes(page)?'block':'none') : 'block';
  });
  const notice=document.getElementById('studentOnlyNotice');
  if(notice){
    if(role==='Siswa'){
      notice.style.display='block';
      notice.innerHTML='<b>Mode Siswa:</b> Anda hanya dapat melihat Dashboard dan informasi ringkas kedisiplinan.';
    }else if(role==='Wali Kelas'){
      notice.style.display='block';
      notice.innerHTML='<b>Mode Wali Kelas:</b> Anda hanya dapat mengakses Dashboard, Pencatatan dan Laporan.';
    }else{
      notice.style.display='none';
    }
  }
  if(allowed){
    const first=allowed[0]||'dashboard';
    document.querySelectorAll('.page').forEach(pg=>pg.classList.remove('active'));
    document.getElementById(first).classList.add('active');
    document.getElementById('pageTitle').textContent=first==='records'?'Pencatatan':first==='reports'?'Laporan':'Dashboard';
  }
}
function showPage(id,btn){
  const role=currentAccount?.level||'';
  const permissions={
    'Siswa':['dashboard'],
    'Wali Kelas':['dashboard','records','reports']
  };
  if(permissions[role] && !permissions[role].includes(id)) return;
  document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));
  if(btn) btn.classList.add('active');
  document.getElementById('pageTitle').textContent=btn?btn.textContent.replace(/[^\w\sÀ-ÿ-]/g,'').trim():id;
  if(id==='reports')renderReport();
}
function refresh(){renderDashboard();renderStudents();renderViolations();renderRecords();renderAccounts();renderImportPreview();fillStudentSelect();loadSettings()}
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function pointsOf(studentId){return data.records.filter(r=>r.studentId==studentId).reduce((a,r)=>a+(data.violations.find(v=>v.id==r.violationId)?.points||0),0)}
function badge(c){return `<span class="badge ${c==='Ringan'?'b-low':c==='Sedang'?'b-mid':'b-high'}">${c}</span>`}

let dashboardBarChart=null, dashboardPieChart=null;
function renderDashboardCharts(){
  if(typeof Chart==='undefined') return;
  const barCanvas=document.getElementById('dashboardBarChart');
  const pieCanvas=document.getElementById('dashboardPieChart');
